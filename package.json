{
  "name": "pin",
  "version": "0.1.0",
  "private": true,
  "main": "frontend/index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "android:prebuild": "expo prebuild --platform android",
    "android:device": "expo run:android --device",
    "android:apk:debug": "expo prebuild --platform android && cd android && gradlew assembleDebug",
    "android:aab:release": "expo prebuild --platform android && cd android && gradlew bundleRelease",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "api": "node backend/server/index.js",
    "dev:android": "npm run api"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.3",
    "babel-preset-expo": "~54.0.10",
    "expo": "^54.0.0",
    "expo-asset": "~12.0.13",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "typescript": "^5.6.3"
  }
}
